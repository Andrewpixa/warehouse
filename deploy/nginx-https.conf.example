# 域名：yaoheng.cloud / www.yaoheng.cloud（均已解析到现网主机）
# 证书路径在 certbot 签发后以 /etc/letsencrypt/live/yaoheng.cloud/ 为准。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name yaoheng.cloud www.yaoheng.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://yaoheng.cloud$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.yaoheng.cloud;

    ssl_certificate     /etc/letsencrypt/live/yaoheng.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yaoheng.cloud/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://yaoheng.cloud$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yaoheng.cloud;

    ssl_certificate     /etc/letsencrypt/live/yaoheng.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yaoheng.cloud/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    location /warehouse/ {
        proxy_pass http://127.0.0.1:8899/warehouse/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

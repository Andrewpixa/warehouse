<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex:1">
  <!-- #endif -->
  <view class="page">
    <!-- 状态筛选 -->
    <view class="filter-bar">
      <view
        v-for="tab in tabs"
        :key="tab.value"
        class="tab-item"
        :class="{ active: currentTab == tab.value }"
        @click="onTabChange(tab.value)"
      >
        <text class="tab-text">{{ tab.label }}</text>
      </view>
    </view>

    <!-- 列表 -->
    <view v-if="orders.length > 0" class="list">
      <view
        v-for="(order, index) in orders"
        :key="index"
        class="order-card"
        @click="goDetail(order)"
      >
        <view class="order-head">
          <view class="head-left">
            <text class="order-no">{{ order['orderNo'] ?? '' }}</text>
            <text v-if="order['invoiceNo']" class="invoice-no">{{ order['invoiceNo'] }}</text>
          </view>
          <view class="status-tag" :style="{ backgroundColor: statusColor(order['status']) }">
            <text class="status-text">{{ order['status'] ?? '草稿' }}</text>
          </view>
        </view>
        <view class="order-body">
          <view class="order-row">
            <text class="row-label">客户</text>
            <text class="row-value">{{ order['customerName'] ?? '-' }}</text>
          </view>
          <view class="order-row">
            <text class="row-label">仓库</text>
            <text class="row-value">{{ order['warehouseName'] ?? '-' }}</text>
          </view>
          <view class="order-row">
            <text class="row-label">出库日期</text>
            <text class="row-value">{{ order['bizDate'] ?? '-' }}</text>
          </view>
          <view v-if="order['paidStatus']" class="order-row">
            <text class="row-label">回款</text>
            <text class="row-value paid">{{ order['paidStatus'] }}</text>
          </view>
          <view class="order-row total">
            <text class="row-label">金额</text>
            <text class="row-value amount">¥{{ order['totalAmount'] ?? '0.00' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view v-else-if="!loading" class="empty-state">
      <text class="empty-emoji">📤</text>
      <text class="empty-text">暂无出库单数据</text>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
import { loadAllOutbound, confirmOutbound, deleteOutbound } from '../../api/outbound'

interface Tab {
  label: string
  value: string
}

const tabs = ref<Tab[]>([
  { label: '全部', value: '' },
  { label: '草稿', value: '草稿' },
  { label: '已确认', value: '已确认' },
  { label: '红冲', value: '红冲' }
])
const currentTab = ref('')
const orders = ref<UTSJSONObject[]>([])
const loading = ref(false)

function statusColor(status: string): string {
  if (status == '已确认') return '#E8F5EE'
  if (status == '红冲') return '#FDECEC'
  if (status == '草稿') return '#FEF3E2'
  return '#F1F3F6'
}

function onTabChange(value: string): void {
  currentTab.value = value
  loadOrders()
}

function loadOrders(): void {
  loading.value = true
  const params = { page: 1, limit: 50 } as UTSJSONObject
  if (currentTab.value.length > 0) {
    params['status'] = currentTab.value
  }
  loadAllOutbound(params).then((res: any) => {
    const result = res as UTSJSONObject
    const dataList = result['data'] as UTSJSONObject[] | null
    if (dataList != null) {
      orders.value = dataList!
    } else {
      orders.value = []
    }
    loading.value = false
  }).catch((err: Error) => {
    loading.value = false
    orders.value = []
  })
}

function goDetail(order: UTSJSONObject): void {
  uni.showToast({ title: '详情页开发中', icon: 'none' })
}

onShow(() => {
  loadOrders()
})
</script>

<style>
.page { flex: 1; background-color: #F4F6FB; }

.filter-bar {
  flex-direction: row;
  background-color: #FFFFFF;
  padding: 20rpx 16rpx;
  gap: 12rpx;
}
.tab-item {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background-color: #F4F6FB;
}
.tab-item.active {
  background-color: #2E6BE6;
}
.tab-text { font-size: 26rpx; color: #6B7280; font-weight: 500; }
.tab-item.active .tab-text { color: #FFFFFF; font-weight: 600; }

.list { padding: 24rpx; }

.order-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.order-head {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
  border-bottom-color: #F1F3F6;
}
.head-left { flex: 1; flex-direction: column; gap: 6rpx; }
.order-no { font-size: 30rpx; font-weight: 700; color: #1F2937; }
.invoice-no { font-size: 22rpx; color: #9AA4B2; }
.status-tag { padding: 6rpx 20rpx; border-radius: 8rpx; }
.status-text { font-size: 24rpx; color: #2D6A4F; font-weight: 600; }

.order-body { gap: 12rpx; }
.order-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.row-label { font-size: 26rpx; color: #9AA4B2; }
.row-value { font-size: 26rpx; color: #374151; }
.row-value.paid { color: #C2410C; font-weight: 500; }
.order-row.total { margin-top: 12rpx; padding-top: 12rpx; border-top-width: 1rpx; border-top-style: solid; border-top-color: #F1F3F6; }
.amount { color: #1D4ED8; font-weight: 700; font-size: 30rpx; }

.empty-state {
  align-items: center;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #9AA4B2; margin-top: 20rpx; }
</style>

<template>
  <view class="page">
    <!-- 查询卡 -->
    <view class="query-card">
      <view class="input-box">
        <text class="input-icon">🧾</text>
        <input
          class="kw-input"
          v-model="keyword"
          placeholder="请输入发票号（完整匹配）"
          placeholder-class="kw-ph"
          confirm-type="search"
          @confirm="onSearch"
        />
        <text v-if="keyword.length > 0" class="kw-clear" @click="onClear">✕</text>
      </view>
      <view class="query-btn" :class="loading ? 'btn-disabled' : ''" @click="onSearch">
        <text class="query-btn-text">{{ loading ? '查询中...' : '加载出库单' }}</text>
      </view>
    </view>

    <scroll-view class="result-scroll" scroll-y>
      <!-- 未查询 -->
      <view v-if="!searched" class="hint-wrap">
        <text class="hint-emoji">📷</text>
        <text class="hint-title">异常纠码</text>
        <text class="hint-sub">先查发票看物流已匹配的码，再点选异常码</text>
        <text class="hint-sub">错码才扫；异常可用 01 代替；缺码填客户说明</text>
      </view>

      <template v-else>
        <!-- 订单摘要 -->
        <view v-if="order != null" class="order-card">
          <view class="order-title-row">
            <text class="order-title">{{ invoiceNoText }}</text>
          </view>
          <view class="order-meta">
            <view class="meta-line"><text class="meta-label">客户</text><text class="meta-value">{{ customerText }}</text></view>
            <view class="meta-line"><text class="meta-label">业务日期</text><text class="meta-value">{{ bizDateText }}</text></view>
            <view class="meta-line"><text class="meta-label">状态</text><text class="meta-value">{{ statusText }}</text></view>
          </view>
        </view>

        <!-- 无数据 -->
        <view v-if="order == null" class="hint-wrap">
          <text class="hint-emoji">🔍</text>
          <text class="hint-title">未查询到出库单</text>
          <text class="hint-sub">请核对发票号是否正确</text>
        </view>

        <!-- 明细列表 -->
        <view v-if="order != null" class="section-bar">
          <text class="section-title">出库明细（点击选中）</text>
          <text class="section-count">{{ items.length }} 项</text>
        </view>
        <view class="item-list">
          <view
            v-for="(it, i) in items"
            :key="i"
            class="item-card"
            :class="i == selectedIndex ? 'item-on' : ''"
            @click="selectItem(i)"
          >
            <view class="item-top">
              <text class="item-name">{{ itemName(it) }}</text>
              <view class="radio" :class="i == selectedIndex ? 'radio-on' : ''">
                <text v-if="i == selectedIndex" class="radio-tick">✓</text>
              </view>
            </view>
            <view class="item-meta">
              <text class="meta-chip">批号 {{ str(it, 'batchNo') }}</text>
              <text class="meta-chip">应出 {{ str(it, 'qty') }}</text>
              <text class="meta-chip" :class="countClass(it)">已匹配 {{ collectedOf(it) }}</text>
            </view>
            <view class="item-spdid">
              <text class="spdid-label">SPDID</text>
              <text class="spdid-value">{{ str(it, 'spdid').length > 0 ? str(it, 'spdid') : '未生成' }}</text>
            </view>
          </view>
        </view>
        <view class="bottom-space"></view>
      </template>
    </scroll-view>

    <!-- 底部采集面板 -->
    <view v-if="order != null" class="panel">
      <view v-if="selectedItem == null" class="panel-hint">
        <text class="panel-hint-text">👆 请先点选明细，再点一条要处理的码</text>
      </view>
      <template v-else>
        <view class="panel-head">
          <text class="panel-title">{{ itemName(selectedItem) }}</text>
          <text class="panel-sub">匹配 {{ collectedOf(selectedItem) }} / 应出 {{ selectedQtyText }}</text>
        </view>
        <scroll-view class="pending-scroll" scroll-x>
          <view class="pending-row">
            <view
              v-for="(c, i) in itemTraces"
              :key="i"
              class="pending-chip"
              :class="selectedTraceIndex == i ? 'pending-on' : ''"
              @click="pickCode(i)"
            >
              <text class="pending-text">{{ str(c, 'code') }}</text>
            </view>
          </view>
        </scroll-view>
        <view v-if="selectedTrace != null" class="panel-hint">
          <text class="panel-hint-text">{{ str(selectedTrace, 'status') }} · {{ str(selectedTrace, 'codeKind') }}</text>
        </view>
        <view class="input-box" style="margin-top: 12rpx">
          <input class="kw-input" v-model="missingNote" placeholder="缺码时填写客户问题描述" placeholder-class="kw-ph" />
        </view>
        <view class="panel-btns">
          <view class="pbtn pbtn-blue" @click="scanReplace">
            <text class="pbtn-text">📷 扫码替换</text>
          </view>
          <view class="pbtn pbtn-green" @click="use01">
            <text class="pbtn-text">01 代替</text>
          </view>
          <view class="pbtn pbtn-orange" @click="askMissing">
            <text class="pbtn-text">缺码说明</text>
          </view>
        </view>
      </template>
    </view>

  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { loadInvoice, replaceAbnormal, reportMissing } from '../../api/trace'

const keyword = ref('')
const loading = ref(false)
const searched = ref(false)
const order = ref<UTSJSONObject | null>(null)
const items = ref<UTSJSONObject[]>([])
const traces = ref<UTSJSONObject[]>([])

const selectedIndex = ref(-1)
const selectedTraceIndex = ref(0)
const missingNote = ref('')
const saving = ref(false)

const selectedItem = computed((): UTSJSONObject | null => {
  const i = selectedIndex.value
  if (i < 0 || i >= items.value.length) return null
  return items.value[i]
})

const itemTraces = computed((): UTSJSONObject[] => {
  const item = selectedItem.value
  if (item == null) return [] as UTSJSONObject[]
  const sp = str(item, 'spdid')
  const rows = [] as UTSJSONObject[]
  for (let i = 0; i < traces.value.length; i++) {
    if (str(traces.value[i], 'spdid') == sp) {
      rows.push(traces.value[i])
    }
  }
  return rows
})

const selectedTrace = computed((): UTSJSONObject | null => {
  const rows = itemTraces.value
  const i = selectedTraceIndex.value
  if (i < 0 || i >= rows.length) return null
  return rows[i]
})

const customerText = computed((): string => {
  if (order.value == null) return ''
  const c = str(order.value, 'customerName')
  if (c.length > 0) return c
  return '客户 #' + numOf(order.value, 'customerId').toString()
})
const invoiceNoText = computed((): string => order.value == null ? '' : str(order.value, 'invoiceNo'))
const bizDateText = computed((): string => order.value == null ? '' : str(order.value, 'bizDate'))
const statusText = computed((): string => order.value == null ? '' : str(order.value, 'status'))
const selectedQtyText = computed((): string => selectedItem.value == null ? '' : str(selectedItem.value, 'qty'))

function str(o: UTSJSONObject | null, key: string): string {
  if (o == null) return ''
  const v = o[key]
  if (v == null) return ''
  if (typeof v == 'string') return v as string
  return v.toString()
}

function numOf(o: UTSJSONObject | null, key: string): number {
  if (o == null) return 0
  const v = o[key]
  if (v == null) return 0
  if (typeof v == 'number') return v as number
  const n = parseInt(v.toString())
  return isNaN(n) ? 0 : n
}

function itemName(it: UTSJSONObject | null): string {
  if (it == null) return ''
  const n = str(it, 'drugName')
  return n.length > 0 ? n : '药品 #' + numOf(it, 'drugId').toString()
}

/** 该明细已采集的追溯码条数 */
function collectedOf(it: UTSJSONObject | null): number {
  if (it == null) return 0
  const sp = str(it, 'spdid')
  if (sp.length == 0) return 0
  let n = 0
  for (let i = 0; i < traces.value.length; i++) {
    if (str(traces.value[i], 'spdid') == sp) n++
  }
  return n
}

/** 已采 vs 应出的软提示配色：相等绿、超出红、不足橙 */
function countClass(it: UTSJSONObject): string {
  const c = collectedOf(it)
  if (c == 0) return ''
  const qty = numOf(it, 'qty')
  if (c == qty) return 'chip-ok'
  if (c > qty) return 'chip-over'
  return 'chip-warn'
}

function onClear(): void { keyword.value = '' }

function onSearch(): void {
  if (loading.value) return
  const kw = keyword.value.trim()
  if (kw.length == 0) {
    uni.showToast({ title: '请输入发票号', icon: 'none' })
    return
  }
  loading.value = true
  searched.value = false
  order.value = null
  items.value = []
  traces.value = []
  selectedIndex.value = -1
  selectedTraceIndex.value = 0
  loadInvoice(kw).then((res: any) => {
    const r = res as UTSJSONObject
    if ((r['code'] as number) == 200) {
      order.value = (r['data'] as UTSJSONObject | null) ?? null
      traces.value = (r['traces'] as UTSJSONObject[] | null) ?? []
      if (order.value != null) {
        items.value = (order.value!['items'] as UTSJSONObject[] | null) ?? []
      }
    }
    searched.value = true
  }).catch((err: Error) => {
    searched.value = true
  }).finally(() => {
    loading.value = false
  })
}

/** 静默刷新（提交/解析后调用），保留选中明细 */
function reload(): void {
  const kw = keyword.value.trim()
  if (kw.length == 0) return
  loadInvoice(kw).then((res: any) => {
    const r = res as UTSJSONObject
    if ((r['code'] as number) == 200) {
      order.value = (r['data'] as UTSJSONObject | null) ?? null
      traces.value = (r['traces'] as UTSJSONObject[] | null) ?? []
      if (order.value != null) {
        items.value = (order.value!['items'] as UTSJSONObject[] | null) ?? []
      }
    }
  }).catch((err: Error) => {})
}

function selectItem(i: number): void {
  selectedIndex.value = i
  selectedTraceIndex.value = 0
}

function pickCode(i: number): void {
  selectedTraceIndex.value = i
}

/** 检查选中明细可采码，返回 SPDID（不可用时已 toast，返回空串） */
function requireSpdid(): string {
  const item = selectedItem.value
  if (item == null) {
    uni.showToast({ title: '请先选中明细', icon: 'none' })
    return ''
  }
  const sp = str(item, 'spdid')
  if (sp.length == 0) {
    uni.showToast({ title: '该明细还没有 SPDID', icon: 'none' })
    return ''
  }
  return sp
}

function scanReplace(): void {
  if (selectedTrace.value == null) {
    uni.showToast({ title: '请先点选一条要纠正的码', icon: 'none' })
    return
  }
  uni.scanCode({
    success: (res) => {
      const code = res.result.trim()
      if (code.length == 0) return
      doReplace(code, false)
    },
    fail: (err) => {
      // #ifdef H5
      uni.showToast({ title: 'H5 端不支持扫码，请在 App 中使用', icon: 'none' })
      // #endif
    }
  })
}

function use01(): void {
  if (selectedTrace.value == null) {
    uni.showToast({ title: '请先点选一条异常码', icon: 'none' })
    return
  }
  doReplace('', true)
}

function doReplace(newCode: string, use01Code: boolean): void {
  const t = selectedTrace.value
  if (t == null) return
  const id = numOf(t, 'id')
  if (id <= 0) {
    uni.showToast({ title: '该码没有记录编号', icon: 'none' })
    return
  }
  saving.value = true
  replaceAbnormal(id, newCode, use01Code, '错码/异常').then((res: any) => {
    const r = res as UTSJSONObject
    const msg = str(r, 'msg')
    uni.showToast({ title: msg.length > 0 ? msg : '已处理', icon: 'none' })
    reload()
  }).catch((err: Error) => {
  }).finally(() => {
    saving.value = false
  })
}

function askMissing(): void {
  const sp = requireSpdid()
  if (sp.length == 0) return
  const note = missingNote.value.trim()
  if (note.length == 0) {
    uni.showToast({ title: '须填写客户问题描述', icon: 'none' })
    return
  }
  saving.value = true
  reportMissing(sp, note).then((r: any) => {
    uni.showToast({ title: '已登记缺码说明', icon: 'none' })
    missingNote.value = ''
    reload()
  }).catch((err: Error) => {
  }).finally(() => {
    saving.value = false
  })
}
</script>

<style>
.page { flex: 1; background-color: #F4F6FB; }

.query-card { background-color: #FFFFFF; padding: 24rpx; }
.input-box { height: 88rpx; background-color: #F8FAFC; border-width: 1rpx; border-style: solid; border-color: #E5E9F0; border-radius: 16rpx; flex-direction: row; align-items: center; padding: 0 24rpx; }
.input-icon { font-size: 32rpx; margin-right: 14rpx; }
.kw-input { flex: 1; height: 88rpx; font-size: 29rpx; color: #111827; }
.kw-ph { color: #9AA4B2; }
.kw-clear { font-size: 24rpx; color: #9AA4B2; padding: 8rpx; }

.query-btn { margin-top: 20rpx; height: 92rpx; border-radius: 16rpx; background: linear-gradient(135deg, #3B82F6, #1D4ED8); align-items: center; justify-content: center; }
.btn-disabled { opacity: 0.6; }
.query-btn-text { color: #FFFFFF; font-size: 31rpx; font-weight: 600; letter-spacing: 4rpx; }

.result-scroll { flex: 1; }

.hint-wrap { align-items: center; padding-top: 140rpx; }
.hint-emoji { font-size: 96rpx; }
.hint-title { font-size: 32rpx; color: #1F2937; font-weight: 700; margin-top: 24rpx; }
.hint-sub { font-size: 25rpx; color: #9AA4B2; margin-top: 12rpx; }

.order-card { margin: 24rpx 24rpx 0; background-color: #FFFFFF; border-radius: 20rpx; padding: 24rpx; border-width: 1rpx; border-style: solid; border-color: #EEF1F6; }
.order-title-row { flex-direction: row; }
.order-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.order-meta { margin-top: 12rpx; }
.meta-line { flex-direction: row; margin-top: 8rpx; }
.meta-label { width: 130rpx; font-size: 25rpx; color: #9AA4B2; }
.meta-value { flex: 1; font-size: 25rpx; color: #374151; }

.section-bar { flex-direction: row; justify-content: space-between; align-items: center; padding: 24rpx 28rpx 12rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1F2937; }
.section-count { font-size: 24rpx; color: #9AA4B2; }

.item-list { padding: 0 24rpx; }
.item-card { background-color: #FFFFFF; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; border-width: 2rpx; border-style: solid; border-color: #EEF1F6; }
.item-on { border-color: #1D4ED8; background-color: #F5F8FF; }
.item-top { flex-direction: row; justify-content: space-between; align-items: center; }
.item-name { flex: 1; font-size: 29rpx; font-weight: 700; color: #111827; padding-right: 16rpx; }
.radio { width: 40rpx; height: 40rpx; border-radius: 20rpx; border-width: 2rpx; border-style: solid; border-color: #C9D2E0; align-items: center; justify-content: center; }
.radio-on { border-color: #1D4ED8; background-color: #1D4ED8; }
.radio-tick { font-size: 24rpx; color: #FFFFFF; font-weight: 700; }

.item-meta { flex-direction: row; flex-wrap: wrap; margin-top: 14rpx; }
.meta-chip { font-size: 22rpx; color: #6B7280; background-color: #F1F3F6; border-radius: 8rpx; padding: 6rpx 14rpx; margin-right: 12rpx; margin-bottom: 8rpx; }
.chip-ok { color: #16A34A; background-color: #E8F5EE; }
.chip-warn { color: #C2410C; background-color: #FEF3E2; }
.chip-over { color: #DC2626; background-color: #FDECEC; }

.item-spdid { margin-top: 6rpx; background-color: #F8FAFC; border-radius: 12rpx; padding: 12rpx 16rpx; flex-direction: row; align-items: center; }
.spdid-label { font-size: 21rpx; color: #9AA4B2; margin-right: 16rpx; }
.spdid-value { flex: 1; font-size: 25rpx; color: #1D4ED8; font-weight: 600; }

.bottom-space { height: 40rpx; }

/* 底部采集面板 */
.panel { background-color: #FFFFFF; border-top-width: 1rpx; border-top-style: solid; border-top-color: #EEF1F6; padding: 20rpx 24rpx 28rpx; }
.panel-hint { align-items: center; padding: 16rpx 0; }
.panel-hint-text { font-size: 26rpx; color: #9AA4B2; }
.panel-head { flex-direction: row; justify-content: space-between; align-items: center; }
.panel-title { flex: 1; font-size: 28rpx; font-weight: 700; color: #111827; padding-right: 16rpx; }
.panel-sub { font-size: 24rpx; color: #6B7280; }

.pending-scroll { margin-top: 14rpx; }
.pending-row { flex-direction: row; }
.pending-chip { flex-direction: row; align-items: center; background-color: #EAF1FE; border-radius: 10rpx; padding: 10rpx 16rpx; margin-right: 12rpx; }
.pending-on { background-color: #1D4ED8; }
.pending-on .pending-text { color: #FFFFFF; }
.pending-text { font-size: 23rpx; color: #1D4ED8; }
.pending-del { font-size: 22rpx; color: #9AA4B2; margin-left: 10rpx; }

.panel-btns { flex-direction: row; margin-top: 18rpx; gap: 16rpx; }
.pbtn { flex: 1; height: 88rpx; border-radius: 14rpx; align-items: center; justify-content: center; }
.pbtn-blue { background-color: #1D4ED8; }
.pbtn-green { background-color: #16A34A; }
.pbtn-orange { background-color: #EA580C; }
.pbtn-text { color: #FFFFFF; font-size: 27rpx; font-weight: 600; }

/* 箱码预览弹窗 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); align-items: center; justify-content: center; z-index: 99; }
.dialog { width: 640rpx; background-color: #FFFFFF; border-radius: 20rpx; padding: 28rpx; }
.dialog-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.dialog-sub { font-size: 24rpx; color: #9AA4B2; margin-top: 10rpx; }
.dialog-scroll { max-height: 480rpx; margin-top: 16rpx; }
.dialog-row { flex-direction: row; align-items: center; padding: 14rpx 0; border-bottom-width: 1rpx; border-bottom-style: solid; border-bottom-color: #F1F3F6; }
.dialog-level { width: 130rpx; font-size: 24rpx; color: #6B7280; }
.dialog-code { flex: 1; font-size: 24rpx; color: #1D4ED8; }
.dialog-btns { flex-direction: row; margin-top: 24rpx; gap: 16rpx; }
.dbtn { flex: 1; height: 80rpx; border-radius: 12rpx; align-items: center; justify-content: center; }
.dbtn-cancel { background-color: #F1F3F6; }
.dbtn-cancel-text { color: #6B7280; font-size: 27rpx; }
.dbtn-ok { background-color: #1D4ED8; }
.dbtn-ok-text { color: #FFFFFF; font-size: 27rpx; font-weight: 600; }
</style>

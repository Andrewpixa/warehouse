<template>
  <scroll-view
    class="scroller"
    scroll-y="true"
    :show-scrollbar="false"
    :refresher-enabled="true"
    :refresher-triggered="refreshing"
    refresher-default-style="black"
    @refresherrefresh="onPullRefresh"
  >
  <view class="page">
    <view class="hero" :class="ready ? 'in' : ''">
      <text class="kicker">这本小程序给谁用</text>
      <text class="title">业务员</text>
      <text class="subtitle">驻院、跑医院的销售岗。医院要货、要退、要结账，先找你。你不收货捡货，也不做会计入账。</text>
    </view>

    <view class="banner-wrap" :class="ready ? 'in' : ''">
      <swiper
        class="banner"
        :indicator-dots="true"
        :autoplay="!previewing"
        :circular="true"
        :interval="3500"
        :duration="500"
        indicator-color="rgba(255,255,255,0.4)"
        indicator-active-color="#FFFFFF"
      >
        <swiper-item>
          <image class="banner-img" src="/static/banner/banner-01.webp" mode="aspectFill" @click="openPreview('/static/banner/banner-01.webp')"></image>
        </swiper-item>
        <swiper-item>
          <image class="banner-img" src="/static/banner/banner-02.webp" mode="aspectFill" @click="openPreview('/static/banner/banner-02.webp')"></image>
        </swiper-item>
        <swiper-item>
          <image class="banner-img" src="/static/banner/banner-03.webp" mode="aspectFill" @click="openPreview('/static/banner/banner-03.webp')"></image>
        </swiper-item>
        <swiper-item>
          <image class="banner-img" src="/static/banner/banner-04.jpg" mode="aspectFill" @click="openPreview('/static/banner/banner-04.jpg')"></image>
        </swiper-item>
      </swiper>
    </view>

    <view v-if="previewing" class="preview" @click="closePreview">
      <image class="preview-img" :src="previewSrc" mode="aspectFit" @click="closePreview"></image>
    </view>

    <view class="card" :class="ready ? 'in d1' : ''">
      <text class="card-title">你在现场做的事</text>
      <view class="row">
        <view class="chip">
          <text class="chip-no">01</text>
          <view class="chip-txt">
            <text class="chip-h">异常纠码</text>
            <text class="chip-d">正常发票只能查看。改码请输入异常纠码发票 20260918000100000099</text>
          </view>
        </view>
        <view class="chip">
          <text class="chip-no">02</text>
          <view class="chip-txt">
            <text class="chip-h">缺货提报</text>
            <text class="chip-d">医院缺药你登记给内勤，采购补货、开票员才能开</text>
          </view>
        </view>
        <view class="chip">
          <text class="chip-no">03</text>
          <view class="chip-txt">
            <text class="chip-h">销退通知</text>
            <text class="chip-d">医院要退，你开通知单签名留痕，再走红冲入库</text>
          </view>
        </view>
        <view class="chip">
          <text class="chip-no">04</text>
          <view class="chip-txt">
            <text class="chip-h">收款勾兑</text>
            <text class="chip-d">按欠款明细对发票提交冲账，到账由会计确认</text>
          </view>
        </view>
      </view>
    </view>

    <view class="cta" :class="ready ? 'in d2' : ''" @click="goNext">
      <text class="cta-text">{{ ctaText }}</text>
    </view>
    <view class="bottom-space"></view>
  </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { isLoggedIn, restoreAuth } from '../../stores/auth'

const logged = ref(false)
const ready = ref(false)
const previewing = ref(false)
const previewSrc = ref('')
const refreshing = ref(false)

function openPreview(src: string): void {
  previewSrc.value = src
  previewing.value = true
}

function closePreview(): void {
  previewing.value = false
}

const ctaText = computed((): string => {
  return logged.value ? '进入工作台' : '登录后进入工作台'
})

function refreshLogin(): void {
  const restored = restoreAuth()
  if (restored) {
    logged.value = true
  } else {
    logged.value = isLoggedIn()
  }
}

function playEnter(): void {
  ready.value = false
  setTimeout(() => {
    ready.value = true
  }, 40)
}

function onPullRefresh(): void {
  refreshing.value = true
  refreshLogin()
  playEnter()
  setTimeout(() => {
    refreshing.value = false
    uni.stopPullDownRefresh()
  }, 600)
}

function goNext(): void {
  if (logged.value) {
    uni.switchTab({ url: '/pages/workbench/index' })
  } else {
    uni.navigateTo({ url: '/pages/login/login' })
  }
}

onShow(() => {
  refreshLogin()
  playEnter()
})

onPullDownRefresh(() => {
  onPullRefresh()
})
</script>

<style>
.scroller { flex: 1; height: 100%; background-color: #F7F4EF; }
.page { flex-direction: column; background-color: #F7F4EF; }
.hero {
  background-color: #1C1917;
  padding: 56rpx 40rpx 52rpx;
  opacity: 0;
  transform: translateY(24rpx);
  transition-property: opacity, transform;
  transition-duration: 480ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}
.title { font-size: 56rpx; font-weight: 700; color: #FAFAF9; margin-top: 16rpx; }
.kicker { font-size: 22rpx; color: #D6D3D1; letter-spacing: 4rpx; }
.subtitle { font-size: 26rpx; color: #A8A29E; margin-top: 18rpx; line-height: 42rpx; }

.banner-wrap {
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  height: 320rpx;
  opacity: 0;
  transform: translateY(24rpx);
  transition-property: opacity, transform;
  transition-duration: 480ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}
.banner { width: 702rpx; height: 320rpx; }
.banner-img { width: 702rpx; height: 320rpx; }

.card {
  background-color: #FFFCF8;
  margin: 24rpx 24rpx 0;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #E7E0D6;
  opacity: 0;
  transform: translateY(28rpx);
  transition-property: opacity, transform;
  transition-duration: 520ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}
.card-title { font-size: 30rpx; font-weight: 700; color: #1C1917; margin-bottom: 8rpx; }

.row { flex-direction: column; }
.chip { flex-direction: row; align-items: flex-start; padding: 22rpx 0; border-bottom-width: 1rpx; border-bottom-style: solid; border-bottom-color: #F3EFE8; }
.chip-no { width: 56rpx; font-size: 24rpx; color: #9A3412; margin-top: 4rpx; letter-spacing: 1rpx; }
.chip-txt { flex: 1; flex-direction: column; }
.chip-h { font-size: 30rpx; font-weight: 700; color: #1C1917; }
.chip-d { font-size: 24rpx; color: #78716C; margin-top: 8rpx; line-height: 36rpx; }

.cta {
  margin: 32rpx 24rpx 0;
  height: 96rpx;
  border-radius: 16rpx;
  background-color: #1C1917;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition-property: opacity, transform;
  transition-duration: 520ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}
.cta-text { color: #FFFFFF; font-size: 30rpx; font-weight: 600; }
.bottom-space { height: 200rpx; }

.in { opacity: 1; transform: translateY(0); }
.d1 { transition-delay: 90ms; }
.d2 { transition-delay: 180ms; }

.preview {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.92);
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.preview-img { width: 750rpx; height: 100%; }
</style>

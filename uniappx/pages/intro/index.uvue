<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex:1">
  <!-- #endif -->
  <view class="page">
    <view class="hero">
      <text class="kicker">药企药品流通 · 业务员端</text>
      <text class="title">医院门口就能办的事</text>
      <text class="subtitle">缺货、销退、冲账、扫码采码。和网页、PC、仓管手机同一套单据，不是另一套账。</text>
    </view>

    <view class="card">
      <text class="card-title">这是给谁用的</text>
      <text class="card-body">给驻院、跑医院的业务员。不是后台管理员控制台，也不替代仓管收货捡货。</text>
    </view>

    <view class="card">
      <text class="card-title">现场四件事</text>
      <view class="row">
        <view class="chip">
          <view class="badge b-teal"><text class="badge-t">扫</text></view>
          <view class="chip-txt">
            <text class="chip-h">扫码采码</text>
            <text class="chip-d">发票/随货同行，当场采追溯码</text>
          </view>
        </view>
        <view class="chip">
          <view class="badge b-blue"><text class="badge-t">缺</text></view>
          <view class="chip-txt">
            <text class="chip-h">缺货补货</text>
            <text class="chip-d">医院缺什么，当场提给内勤</text>
          </view>
        </view>
        <view class="chip">
          <view class="badge b-amber"><text class="badge-t">退</text></view>
          <view class="chip-txt">
            <text class="chip-h">销退通知</text>
            <text class="chip-d">医院要退，先留痕再走红冲</text>
          </view>
        </view>
        <view class="chip">
          <view class="badge b-green"><text class="badge-t">账</text></view>
          <view class="chip-txt">
            <text class="chip-h">收款冲账</text>
            <text class="chip-d">对发票、看未回款，不当场改库存</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="card-title">五端怎么分工</text>
      <view class="split">
        <text class="split-line">网页：全量指挥、日清月结</text>
        <text class="split-line">PC 工作台：查发票、查未回款</text>
        <text class="split-line">本小程序：业务员现场提报与扫码</text>
        <text class="split-line">仓管手机：收货、捡货、推进异常</text>
      </view>
    </view>

    <view class="cta" @click="goNext">
      <text class="cta-text">{{ ctaText }}</text>
    </view>
    <view class="hint-wrap">
      <text class="hint">登录后可随时从底部「介绍」回来看</text>
    </view>
    <view class="bottom-space"></view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
import { isLoggedIn, restoreAuth } from '../../stores/auth'

const logged = ref(false)

const ctaText = computed((): string => {
  return logged.value ? '进入工作台' : '登录后进入工作台'
})

function refreshLogin(): void {
  const restored = restoreAuth()
  if (restored) {
    logged.value = true
  } else {
    logged.value = isLoggedIn()
  }
}

function goNext(): void {
  if (logged.value) {
    uni.switchTab({ url: '/pages/workbench/index' })
  } else {
    uni.navigateTo({ url: '/pages/login/login' })
  }
}

onShow(() => {
  refreshLogin()
})
</script>

<style>

<template>
  <scroll-view class="page-scroll" scroll-y="true">
  <view class="container">
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-text">{{ avatarChar }}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userName }}</text>
        <text class="user-detail">{{ userRoleDept }}</text>
        <text class="user-tag">业务员现场端</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" @click="navigateTo('/pages/profile/profile-edit')">
        <text class="menu-label">个人信息</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/profile/change-password')">
        <text class="menu-label">修改密码</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/profile/operation-log')">
        <text class="menu-label">操作日志</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item last" @click="goIntro">
        <text class="menu-label">产品介绍</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view v-if="showAdmin" class="menu-card">
      <text class="group-title">系统管理（非现场作业）</text>
      <view class="menu-item" @click="navigateTo('/pages/system/user')">
        <text class="menu-label">用户管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/system/role')">
        <text class="menu-label">角色管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/system/notice-manage')">
        <text class="menu-label">公告管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item last" @click="navigateTo('/pages/system/loginfo')">
        <text class="menu-label">登录日志</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="btn-wrap">
      <button class="logout-btn" @click="handleLogout">退出登录</button>
    </view>
  </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { getUser, logout, isSuperAdmin } from '../../stores/auth'

const avatarChar = computed((): string => {
  const user = getUser()
  if (user != null && user.name.length > 0) {
    return user.name.substring(0, 1)
  }
  return '业'
})

const userName = computed((): string => {
  const user = getUser()
  return user != null ? user.name : '未登录'
})

const userRoleDept = computed((): string => {
  const user = getUser()
  if (user == null) return ''
  let parts : string[] = []
  if (user.departmentName != null && user.departmentName!.length > 0) {
    parts.push(user.departmentName!)
  }
  if (parts.length == 0) {
    parts.push(user.loginname)
  }
  return parts.join(' · ')
})

const showAdmin = computed((): boolean => {
  return isSuperAdmin()
})

function navigateTo(url : string) : void {
  uni.navigateTo({ url: url })
}

function goIntro() : void {
  uni.switchTab({ url: '/pages/intro/index' })
}

function handleLogout() : void {
  uni.showModal({
    title: '提示',
    content: '确定退出登录吗？',
    confirmText: '确定',
    cancelText: '取消',
    success: (res) => {
      if (res.confirm) {
        logout().then(() => {
          uni.reLaunch({
            url: '/pages/intro/index'
          })
        })
      }
    }
  })
}
</script>

<style>
.container {
  background-color: #F7F4EF;
  padding: 24rpx;
}

.user-card {
  flex-direction: row;
  align-items: center;
  background-color: #FFFCF8;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #E7E0D6;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: #1C1917;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #F7F4EF;
  font-weight: 700;
}

.user-info {
  flex: 1;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1917;
}

.user-detail {
  font-size: 24rpx;
  color: #78716C;
  margin-top: 8rpx;
}

.user-tag {
  font-size: 22rpx;
  color: #9A3412;
  margin-top: 10rpx;
}

.menu-card {
  flex-direction: column;
  background-color: #FFFCF8;
  border-radius: 28rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-width: 1rpx;
  border-style: solid;
  border-color: #E7E0D6;
}

.group-title {
  font-size: 22rpx;
  color: #A8A29E;
  padding: 24rpx 32rpx 0;
}

.menu-item {
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  border-bottom-width: 1rpx;
  border-bottom-color: #F3EFE8;
  border-bottom-style: solid;
}

.menu-item.last {
  border-bottom-width: 0;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1C1917;
}

.menu-arrow {
  font-size: 28rpx;
  color: #D6D3D1;
}

.btn-wrap {
  margin-top: 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FFFCF8;
  color: #B91C1C;
  font-size: 30rpx;
  border-radius: 16rpx;
  border-width: 1rpx;
  border-style: solid;
  border-color: #E7E0D6;
}
</style>

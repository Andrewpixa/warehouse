<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex:1">
  <!-- #endif -->
  <view class="container">
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-text">{{ avatarChar }}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userName }}</text>
        <text class="user-detail">{{ userRoleDept }}</text>
        <text class="user-tag">业务员现场端</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" @click="navigateTo('/pages/profile/profile-edit')">
        <text class="menu-label">个人信息</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/profile/change-password')">
        <text class="menu-label">修改密码</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/profile/operation-log')">
        <text class="menu-label">操作日志</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item last" @click="goIntro">
        <text class="menu-label">产品介绍</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view v-if="showAdmin" class="menu-card">
      <text class="group-title">系统管理（非现场作业）</text>
      <view class="menu-item" @click="navigateTo('/pages/system/user')">
        <text class="menu-label">用户管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/system/role')">
        <text class="menu-label">角色管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" @click="navigateTo('/pages/system/notice-manage')">
        <text class="menu-label">公告管理</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item last" @click="navigateTo('/pages/system/loginfo')">
        <text class="menu-label">登录日志</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="btn-wrap">
      <button class="logout-btn" @click="handleLogout">退出登录</button>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
import { getUser, logout, isSuperAdmin } from '../../stores/auth'

const avatarChar = computed((): string => {
  const user = getUser()
  if (user != null && user.name.length > 0) {
    return user.name.substring(0, 1)
  }
  return '业'
})

const userName = computed((): string => {
  const user = getUser()
  return user != null ? user.name : '未登录'
})

const userRoleDept = computed((): string => {
  const user = getUser()
  if (user == null) return ''
  let parts : string[] = []
  if (user.departmentName != null && user.departmentName!.length > 0) {
    parts.push(user.departmentName!)
  }
  if (parts.length == 0) {
    parts.push(user.loginname)
  }
  return parts.join(' · ')
})

const showAdmin = computed((): boolean => {
  return isSuperAdmin()
})

function navigateTo(url : string) : void {
  uni.navigateTo({ url: url })
}

function goIntro() : void {
  uni.switchTab({ url: '/pages/intro/index' })
}

function handleLogout() : void {
  uni.showModal({
    title: '提示',
    content: '确定退出登录吗？',
    confirmText: '确定',
    cancelText: '取消',
    success: (res) => {
      if (res.confirm) {
        logout().then(() => {
          uni.reLaunch({
            url: '/pages/intro/index'
          })
        })
      }
    }
  })
}
</script>

<style>
.container {
  flex: 1;
  background-color: #F3F6F8;
  padding: 24rpx;
}

.user-card {
  flex-direction: row;
  align-items: center;
  background-color: #0F766E;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background-color: rgba(255,255,255,0.18);
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.user-info {
  flex: 1;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-detail {
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
  margin-top: 8rpx;
}

.user-tag {
  font-size: 22rpx;
  color: #D1FAE5;
  margin-top: 10rpx;
}

.menu-card {
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.group-title {
  font-size: 22rpx;
  color: #94A3B8;
  padding: 24rpx 32rpx 0;
}

.menu-item {
  flex-direction: row;
  align-items: center;
  padding: 32rpx;
  border-bottom-width: 1rpx;
  border-bottom-color: #F1F5F9;
  border-bottom-style: solid;
}

.menu-item.last {
  border-bottom-width: 0;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1E293B;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CBD5E1;
}

.btn-wrap {
  margin-top: 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FFFFFF;
  color: #DC2626;
  font-size: 30rpx;
  border-radius: 16rpx;
}
</style>

import { getBaseUrl, getSaTokenHeader, isRetriableStatus, switchApiBaseUrl } from './request'

export function uploadFile(filePath: string): Promise<UTSJSONObject> {
  return new Promise((resolve, reject) => {
    const fire = (attempt: number) => {
      uni.uploadFile({
        url: getBaseUrl() + '/file/uploadFile',
        filePath: filePath,
        name: 'mf',
        header: getSaTokenHeader(),
        success: (res) => {
          const statusCode = res.statusCode
          // 被重定向或无有效响应 → 换线路重试一次
          if (isRetriableStatus(statusCode) && attempt < 2) {
            switchApiBaseUrl()
            fire(attempt + 1)
            return
          }
          const data = JSON.parse(res.data) as UTSJSONObject
          if (data['code'] == 200) {
            resolve(data)
          } else {
            reject(new Error((data['msg'] as string) ?? '上传失败'))
          }
        },
        fail: (err) => {
          // TLS reset / 连接失败 → 换线路重试一次
          if (attempt < 2) {
            switchApiBaseUrl()
            fire(attempt + 1)
            return
          }
          reject(new Error(err.errMsg))
        }
      })
    }
    fire(1)
  })
}

export function getImageUrl(path: string): string {
  return getBaseUrl() + '/file/showImageByPath?path=' + encodeURIComponent(path)
}

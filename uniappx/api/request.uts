/**
 * 网络请求封装
 * 基于 uni.request，适配仓库管理系统后端（SA-Token + form-urlencoded）
 */

// SA-Token 存储（微信小程序可能不支持 cookie，通过请求头传递）
const SA_TOKEN_KEY = 'satoken_value'

function saveSaToken(token : string) : void {
	if (token.length > 0) {
		uni.setStorageSync(SA_TOKEN_KEY, token)
	}
}

function getSaToken() : string {
	const val = uni.getStorageSync(SA_TOKEN_KEY)
	return val != null ? (val as string) : ''
}

export function clearSaToken() : void {
	uni.removeStorageSync(SA_TOKEN_KEY)
}

// 首选：Nginx 反代 + HTTPS 域名（微信小程序合法域名 / 真机网络）
const PRIMARY_BASE_URL = 'https://yaoheng.cloud/warehouse'

// 兜底：直连 Spring Boot 8899 端口（HTTP 明文）。
// 部分网络下 yaoheng.cloud:443 的 TLS 握手会被链路 reset，
// 且 http://123.57.134.57 的 80 端口已被 Nginx 301 强制跳转 HTTPS，
// 故连接失败/收到 301 时自动降级到 8899 直连（同一后端进程，token 一致）。
// 注意：微信小程序真机正式版不允许明文 HTTP，兜底仅在开发者工具/真机调试下生效。
const FALLBACK_BASE_URL = 'http://123.57.134.57:8899/warehouse'

let activeBaseUrl = PRIMARY_BASE_URL

/** 当前生效的接口地址（随网络故障自动切换） */
export function getBaseUrl() : string {
	return activeBaseUrl
}

function switchBaseUrl() : void {
	activeBaseUrl = activeBaseUrl == PRIMARY_BASE_URL ? FALLBACK_BASE_URL : PRIMARY_BASE_URL
}

/** 判断是否为需要换线路重试的响应（重定向或无有效状态码） */
export function isRetriableStatus(statusCode : number) : boolean {
	return statusCode == 0 || statusCode == 301 || statusCode == 302 || statusCode == 307 || statusCode == 308
}

/** 连接故障/重定向后切换到另一条线路（上传等场景复用） */
export function switchApiBaseUrl() : void {
	switchBaseUrl()
}

/** 构建带 SA-Token 的请求头（uploadFile 等场景复用） */
export function getSaTokenHeader() : UTSJSONObject {
	const header : UTSJSONObject = {}
	const saToken = getSaToken()
	if (saToken.length > 0) {
		header['satoken'] = saToken
	}
	return header
}

/**
 * 后端响应格式：DataGridView / ResultObj
 */
export interface ApiResponse {
	code : number
	msg : string
	count ?: number
	data ?: UTSJSONObject | UTSJSONObject[] | null
	user ?: UTSJSONObject
	menus ?: UTSJSONObject[]
	permissions ?: string[]
}

interface RequestOptions {
	url : string
	method : 'GET' | 'POST'
	data ?: UTSJSONObject
	header ?: UTSJSONObject
	showLoading ?: boolean
	dataType ?: 'json' | 'string'
	responseType ?: 'text' | 'arraybuffer'
	contentType ?: string
}

/**
 * 将对象转为 URL 查询字符串
 */
function buildQueryString(params : UTSJSONObject | null) : string {
	if (params == null) {
		return ''
	}
	const p = params!!
	const keys = Object.keys(p)
	if (keys.length == 0) {
		return ''
	}
	let parts : string[] = []
	for (let i = 0; i < keys.length; i++) {
		const key = keys[i]
		const value = params[key]
		if (value != null) {
			parts.push(key + '=' + encodeURIComponent(value.toString()))
		}
	}
	return parts.join('&')
}

/**
 * 核心请求函数
 */
export function request<T>(options : RequestOptions) : Promise<T> {
	return new Promise<T>((resolve, reject) => {
		if (options.showLoading == true) {
			uni.showLoading({
				title: '加载中...',
				mask: true
			})
		}

		// 接口路径 + GET 查询串（base 部分在每次发起时按当前线路拼接）
		let pathWithQuery = options.url
		if (options.method == 'GET' && options.data != null) {
			const qs = buildQueryString(options.data)
			if (qs.length > 0) {
				const separator = pathWithQuery.includes('?') ? '&' : '?'
				pathWithQuery = pathWithQuery + separator + qs
			}
		}

		// 确定 Content-Type
		const contentType = options.contentType ?? 'application/x-www-form-urlencoded'

		// 构建请求头
		let header : UTSJSONObject = {
			'Content-Type': contentType
		}
		// 携带 SA-Token（用于小程序等不支持 cookie 的环境）
		const saToken = getSaToken()
		if (saToken.length > 0) {
			header['satoken'] = saToken
		}
		const optHeader = options.header
		if (optHeader != null) {
			const headerKeys = Object.keys(optHeader)
			for (let i = 0; i < headerKeys.length; i++) {
				const key = headerKeys[i]
				header[key] = optHeader[key]
			}
		}

		// POST 请求：将对象转为 form-urlencoded 字符串
		let postData : string | UTSJSONObject | null = null
		if (options.method == 'POST') {
			if (contentType.includes('application/json')) {
				postData = options.data
			} else {
				postData = buildQueryString(options.data)
			}
		}

		// 发起一次请求；网络失败或被 301/302 跳转时切换线路再试一次
		const fire = (attempt : number) => {
			const fullUrl = activeBaseUrl + pathWithQuery
			uni.request({
				url: fullUrl,
				method: options.method,
				data: postData,
				header: header,
				dataType: options.dataType ?? 'json',
				responseType: options.responseType ?? 'text',
				withCredentials: true,
				success: (res) => {
					const statusCode = res.statusCode

					// 被重定向（80 端口强制跳 HTTPS）→ 换线路重试一次
					if (isRetriableStatus(statusCode) && attempt < 2) {
						switchBaseUrl()
						fire(attempt + 1)
						return
					}

					if (options.showLoading == true) {
						uni.hideLoading()
					}

					// 从响应头保存 SA-Token
					const resHeader = res.header as UTSJSONObject | null
					if (resHeader != null) {
						const token = resHeader!['satoken'] as string | null
						if (token != null && token!.length > 0) {
							saveSaToken(token!)
						}
					}

					// 401 未授权 → 跳转登录页
					if (statusCode == 401) {
						uni.showToast({
							title: '登录已过期，请重新登录',
							icon: 'none',
							duration: 1500
						})
						setTimeout(() => {
							uni.reLaunch({
								url: '/pages/login/login'
							})
						}, 1500)
						reject(new Error('未授权'))
						return
					}

					// HTTP 错误
					if (statusCode < 200 || statusCode >= 300) {
						uni.showToast({
							title: '请求失败 (' + statusCode.toString() + ')',
							icon: 'none'
						})
						reject(new Error('HTTP错误: ' + statusCode.toString()))
						return
					}

					// 解析响应体
					const result = res.data as ApiResponse

					// 业务错误处理：code === -1
					if (result.code == -1) {
						uni.showToast({
							title: result.msg.length > 0 ? result.msg : '操作失败',
							icon: 'none'
						})
						reject(new Error(result.msg.length > 0 ? result.msg : '操作失败'))
						return
					}

					resolve(result as T)
				},
				fail: (err) => {
					// TLS reset / 连接超时 / 域名不通 → 换线路重试一次
					if (attempt < 2) {
						switchBaseUrl()
						fire(attempt + 1)
						return
					}
					if (options.showLoading == true) {
						uni.hideLoading()
					}
					uni.showToast({
						title: '网络错误',
						icon: 'none'
					})
					reject(new Error(err.errMsg))
				}
			})
		}

		fire(1)
	})
}

/**
 * GET 请求
 * @param url 接口路径（不含 BASE_URL）
 * @param params 查询参数
 */
export function get<T>(url : string, params : UTSJSONObject | null = null) : Promise<T> {
	return request<T>({
		url: url,
		method: 'GET',
		data: params
	})
}

/**
 * POST 请求（form-urlencoded 格式，适配后端 VO 接收表单参数）
 * @param url 接口路径
 * @param data 请求体
 */
export function post<T>(url : string, data : UTSJSONObject | null = null) : Promise<T> {
	return request<T>({
		url: url,
		method: 'POST',
		data: data,
		contentType: 'application/x-www-form-urlencoded'
	})
}

/**
 * POST 请求（参数通过 URL query string 传递，body 为空）
 * 适配 warehouse-front 中 POST + params 模式
 */
export function postWithParams<T>(url : string, params : UTSJSONObject | null = null) : Promise<T> {
	let fullUrl = url
	if (params != null) {
		const qs = buildQueryString(params!!)
		if (qs.length > 0) {
			fullUrl = url + '?' + qs
		}
	}
	return request<T>({
		url: fullUrl,
		method: 'POST',
		data: null,
		contentType: 'application/x-www-form-urlencoded'
	})
}

/**
 * POST JSON 请求（application/json 格式，支持对象和数组）
 * @param url 接口路径
 * @param data 请求体（对象或数组）
 */
export function postJson<T>(url : string, data : any = null) : Promise<T> {
	return new Promise<T>((resolve, reject) => {
		const header : UTSJSONObject = {
			'Content-Type': 'application/json'
		}
		const saToken = getSaToken()
		if (saToken.length > 0) {
			header['satoken'] = saToken
		}

		const fire = (attempt : number) => {
			uni.request({
				url: activeBaseUrl + url,
				method: 'POST',
				data: data,
				header: header,
				dataType: 'json',
				responseType: 'text',
				withCredentials: true,
				success: (res) => {
					const statusCode = res.statusCode
					// 被重定向 → 换线路重试一次
					if (isRetriableStatus(statusCode) && attempt < 2) {
						switchBaseUrl()
						fire(attempt + 1)
						return
					}
					const resHeader = res.header as UTSJSONObject | null
					if (resHeader != null) {
						const token = resHeader!['satoken'] as string | null
						if (token != null && token!.length > 0) {
							saveSaToken(token!)
						}
					}
					if (statusCode == 401) {
						uni.showToast({ title: '登录已过期', icon: 'none' })
						setTimeout(() => { uni.reLaunch({ url: '/pages/login/login' }) }, 1500)
						reject(new Error('未授权'))
						return
					}
					if (statusCode < 200 || statusCode >= 300) {
						uni.showToast({ title: '请求失败', icon: 'none' })
						reject(new Error('HTTP错误'))
						return
					}
					const result = res.data as ApiResponse
					if (result.code == -1) {
						uni.showToast({ title: result.msg.length > 0 ? result.msg : '操作失败', icon: 'none' })
						reject(new Error(result.msg))
						return
					}
					resolve(result as T)
				},
				fail: (err) => {
					if (attempt < 2) {
						switchBaseUrl()
						fire(attempt + 1)
						return
					}
					uni.showToast({ title: '网络错误', icon: 'none' })
					reject(new Error(err.errMsg))
				}
			})
		}

		fire(1)
	})
}
